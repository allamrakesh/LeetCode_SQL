select
Request_at as Day,
round(sum(case when status <> 'completed' then 1.0 else 0 end)/count(*),2) as [Cancellation Rate]
from trips t
join users c
on t.Client_id = c.Users_id
join users d
on t.Driver_id = d.Users_id
where c.Banned = 'No'
and d.Banned = 'No'
and Request_at between '2013-10-01' and '2013-10-03'
group by request_at
order by request_at;
