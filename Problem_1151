SELECT
    u.user_id AS buyer_id,
    u.join_date,
    o.order_date AS first_order
FROM Users u
LEFT JOIN Orders o
    ON u.user_id = o.buyer_id
    AND o.order_date >= '2019-01-01'
    AND o.order_date < '2020-01-01'
    AND o.order_date = (
        SELECT MIN(o2.order_date)
        FROM Orders o2
        WHERE o2.buyer_id = o.buyer_id
          AND o2.order_date >= '2019-01-01'
          AND o2.order_date < '2020-01-01'
    );
